{
  "name": "@code-monet/shared",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts"
    },
    "./canvas": {
      "types": "./src/canvas/index.ts",
      "import": "./src/canvas/index.ts"
    },
    "./websocket": {
      "types": "./src/websocket/index.ts",
      "import": "./src/websocket/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "prettier": "^3.2.0",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "react": ">=19.2.3"
  },
  "dependencies": {
    "perfect-freehand": "^1.2.2"
  }
}
