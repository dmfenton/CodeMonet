{
  "name": "@code-monet/web",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:vite": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc && vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "preview": "cross-env NODE_ENV=production tsx server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@code-monet/shared": "*",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-router": "^8.3.0",
    "sirv": "^3.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "cross-env": "^10.1.0",
    "http-proxy-middleware": "^4.2.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.2.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
