# Claude development uses isolated Claude subscription auth. Production injects
# Anthropic workload-identity fields and a short-lived token file from compute.

# Optional OpenAI backend
# AGENT_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_AGENT_MODEL=gpt-5-mini
# OPENAI_AGENT_MODEL_PROD=gpt-5

# Optional - Server Configuration
HOST=0.0.0.0
PORT=8000

# Optional - Agent Configuration
AGENT_INTERVAL=10
STATE_FILE=state.json

# Optional - Frontend Configuration (for Expo)
# EXPO_PUBLIC_WS_URL=ws://localhost:8000/ws
