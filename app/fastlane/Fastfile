# Fastfile for Code Monet iOS builds
# https://docs.fastlane.tools

require "json"

default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    # Set up App Store Connect API key from environment
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_P8"],
      is_key_content_base64: false,
      in_house: false
    )

    app_root = File.expand_path("..", __dir__)
    archive_path = File.join(app_root, "build/CodeMonet.xcarchive")
    ipa_path = File.join(app_root, "build/CodeMonet.ipa")

    # Build the app
    build_app(
      workspace: "ios/CodeMonet.xcworkspace",
      scheme: "CodeMonet",
      archive_path: archive_path,
      clean: true,
      skip_codesigning: true,
      skip_package_ipa: true,
    )

    manifest_path = File.join(app_root, "build/CodeMonet-signing.json")
    File.write(
      manifest_path,
      JSON.generate(
        archive_path: archive_path,
        output_ipa: ipa_path,
        bundles: [
          {
            path: "Products/Applications/CodeMonet.app",
            profile: ENV.fetch("IOS_PROVISIONING_PROFILE_PATH"),
            entitlements: File.join(app_root, "ios/CodeMonet/CodeMonet.entitlements"),
          },
        ],
      ),
    )
    sh(
      ENV.fetch("FENTON_IOS_SIGNER_PATH"),
      manifest_path,
      ENV.fetch("FENTON_IOS_SIGNING_IDENTITY_SHA1"),
      ENV.fetch("FENTON_IOS_KEYCHAIN_PATH"),
    )

    # Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: false
    )
  end

  desc "Build only (no upload)"
  lane :build do
    build_app(
      workspace: "ios/CodeMonet.xcworkspace",
      scheme: "CodeMonet",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "CodeMonet.ipa",
      clean: true
    )
  end
end
