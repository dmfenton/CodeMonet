# Fastfile for Code Monet iOS builds
# https://docs.fastlane.tools
#
# Builds the native SwiftUI app (ios/CodeMonet.xcodeproj, generated by
# `xcodegen generate`) and uploads to TestFlight. Signing is handled the
# same way as the rest of the fenton-ci fleet: the archive is built
# unsigned (skip_codesigning), then a signing manifest is handed to the
# shared out-of-process signer identified by FENTON_IOS_SIGNER_PATH.

require "json"

default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    # Set up App Store Connect API key from environment
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_P8"],
      is_key_content_base64: false,
      in_house: false
    )

    app_root = File.expand_path("..", __dir__)
    archive_path = File.join(app_root, "build/CodeMonet.xcarchive")
    ipa_path = File.join(app_root, "build/CodeMonet.ipa")

    # Build the app
    build_app(
      project: File.join(app_root, "CodeMonet.xcodeproj"),
      scheme: "CodeMonet",
      archive_path: archive_path,
      clean: true,
      skip_codesigning: true,
      skip_package_ipa: true,
      xcargs: "MARKETING_VERSION=#{ENV.fetch('APP_VERSION')} CURRENT_PROJECT_VERSION=#{ENV.fetch('APP_BUILD_NUMBER')}",
    )

    manifest_path = File.join(app_root, "build/CodeMonet-signing.json")
    File.write(
      manifest_path,
      JSON.generate(
        archive_path: archive_path,
        output_ipa: ipa_path,
        bundles: [
          {
            path: "Products/Applications/CodeMonet.app",
            profile: ENV.fetch("IOS_PROVISIONING_PROFILE_PATH"),
            entitlements: File.join(app_root, "CodeMonet/Resources/CodeMonet.entitlements"),
          },
        ],
      ),
    )
    sh(
      ENV.fetch("FENTON_IOS_SIGNER_PATH"),
      manifest_path,
      ENV.fetch("FENTON_IOS_SIGNING_IDENTITY_SHA1"),
      ENV.fetch("FENTON_IOS_KEYCHAIN_PATH"),
    )

    # Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: false
    )
  end
end
