{
  "name": "code-monet",
  "private": true,
  "workspaces": [
    "shared",
    "web"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/js": "^10.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "body-parser": "2.3.0",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "nanoid@3": "3.3.18",
    "qs": "6.16.0",
    "postcss": "8.5.23",
    "shell-quote": "1.10.0",
    "tar@7": "7.5.22",
    "undici@6": "6.28.0",
    "ws@7": "7.5.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
